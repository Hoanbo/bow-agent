# BOW AGENT V4 RUNTIME CONFIGURATION
# Copy this file to .env. Never commit .env or paste a real secret into chat.
NODE_ENV=production
BOW_AGENT_PORT=4000
# Bind loopback first. Put a reverse proxy/VPN in front before exposing it.
BOW_AGENT_HOST=127.0.0.1
# Comma-separated trusted browser origins; leave blank when using no browser UI.
BOW_CORS_ALLOWED_ORIGINS=https://agent.example.com
# Upper bound for JSON request bodies (1 MiB).
BOW_MAX_REQUEST_BODY_BYTES=1048576

# Gemini LLM Provider
# Create the key in Google AI Studio and set it only in your local .env.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# Ollama local inference (the OpenAI-compatible endpoint is /v1).
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_WHISPER_URL=http://127.0.0.1:8080/v1/audio/transcriptions
SPEECH_PREFER_LOCAL=true

# Desktop Control Auth Guard (bow-remote-agent)
# Generate independent, long random values; do not use these placeholders.
BOW_DESKTOP_AUTH_TOKEN=replace_with_a_32_plus_character_random_secret

# Robot Channel Gateway Secret (bow-robot)
ROBOT_GATEWAY_SECRET=replace_with_a_32_plus_character_random_secret

# Shop webhooks use an independent secret. Sign `timestamp.rawBody` with
# HMAC-SHA256 and send X-BOW-Timestamp + X-BOW-Signature: v1=<hex>.
BOW_SHOP_WEBHOOK_SECRET=replace_with_a_different_32_plus_character_random_secret
BOW_WEBHOOK_MAX_AGE_SECONDS=300

# Never enable this on the host in production. A future isolated runner must
# replace the current JavaScript AsyncFunction implementation first.
BOW_ENABLE_DYNAMIC_CODE=false

# Vietnamese Edge-TTS Voice Config
EDGE_TTS_VOICE_FEMALE=vi-VN-HoaiMyNeural
EDGE_TTS_VOICE_MALE=vi-VN-NamMinhNeural

# Speech-To-Text Endpoints
FASTER_WHISPER_URL=http://127.0.0.1:8000/v1/audio/transcriptions
OPENAI_API_KEY=your_openai_api_key_here
