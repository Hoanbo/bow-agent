# BOW AGENT V3.3 RUNTIME CONFIGURATION
NODE_ENV=development
BOW_AGENT_PORT=4000
BOW_AGENT_HOST=0.0.0.0

# Gemini LLM Provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Desktop Control Auth Guard (bow-remote-agent)
BOW_DESKTOP_AUTH_TOKEN=bow-desktop-secure-token-v3

# Robot Channel Gateway Secret (bow-robot)
ROBOT_GATEWAY_SECRET=bow-robot-secure-key-v3

# Vietnamese Edge-TTS Voice Config
EDGE_TTS_VOICE_FEMALE=vi-VN-HoaiMyNeural
EDGE_TTS_VOICE_MALE=vi-VN-NamMinhNeural

# Speech-To-Text Endpoints
FASTER_WHISPER_URL=http://127.0.0.1:8000/v1/audio/transcriptions
OPENAI_API_KEY=your_openai_api_key_here
