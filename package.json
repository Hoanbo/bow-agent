{
    "name": "@bow/agent",
    "version": "4.0.0",
    "description": "BOW Con V4.0 — The Fully Autonomous Self-Evolving Embodied AI Co-Founder & Universal Brain (Level 4.0 Autonomy)",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "scripts": {
        "start": "tsx src/server.ts",
        "build": "tsc -b && node scripts/sync_ecosystem.js",
        "sync:ecosystem": "node scripts/sync_ecosystem.js",
        "typecheck": "tsc -b --noEmit",
        "test": "tsx tests/test_phase7_1_step4_extraction.ts",
        "test:multichannel": "tsx tests/test_multichannel_v3_3.ts",
        "test:executive": "tsx tests/test_executive_v3_4.ts",
        "test:vision": "tsx tests/test_screen_vision_v3_5.ts",
        "test:combined": "tsx tests/test_v3_6_combined.ts",
        "test:v4m1": "tsx tests/test_v4_milestone1_local_speech.ts",
        "test:v4m2": "tsx tests/test_v4_milestone2_full_duplex.ts",
        "test:v4m3": "tsx tests/test_v4_milestone3_embodied.ts",
        "test:admin": "tsx tests/test_shop_admin_copilot.ts",
        "test:all": "tsx tests/test_phase7_1_step4_extraction.ts && tsx tests/test_multichannel_v3_3.ts && tsx tests/test_executive_v3_4.ts && tsx tests/test_screen_vision_v3_5.ts && tsx tests/test_v3_6_combined.ts && tsx tests/test_v4_milestone1_local_speech.ts && tsx tests/test_v4_milestone2_full_duplex.ts && tsx tests/test_v4_milestone3_embodied.ts && tsx tests/test_shop_admin_copilot.ts && tsx tests/test_bow_con_phase1_memory.ts && tsx tests/test_bow_con_phase2_self_tool.ts && tsx tests/test_bow_con_phase3_multiagent.ts",
        "test:phase1": "tsx tests/test_bow_con_phase1_memory.ts",
        "test:phase2": "tsx tests/test_bow_con_phase2_self_tool.ts",
        "test:phase3": "tsx tests/test_bow_con_phase3_multiagent.ts"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "dotenv": "^17.4.2",
        "ws": "^8.21.3"
    },
    "devDependencies": {
        "@types/node": "^22.20.1",
        "@types/ws": "^8.18.1",
        "tsx": "^4.19.0",
        "typescript": "^5.6.2"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        }
    },
    "files": [
        "dist"
    ]
}